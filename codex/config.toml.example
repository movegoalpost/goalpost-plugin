# Goalpost — Codex config snippet
#
# Add this to ~/.codex/config.toml to connect the Codex CLI (and the
# ChatGPT desktop app, which reads the same file) to Goalpost's remote
# MCP endpoint, then sign in once:
#
#   codex mcp login goalpost
#
# Codex identifies itself to Goalpost's OAuth server with the client
# metadata document it publishes and opens the consent screen in your
# browser; pick the workspace to bind.

[mcp_servers.goalpost]
url = "https://api.movegoalpost.com/api/mcp"
